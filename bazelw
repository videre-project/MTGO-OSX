#!/bin/bash
set -euo pipefail

project_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
version=$(cat "$project_dir/.bazelversion")
case "$(uname -s)-$(uname -m)" in
    Darwin-arm64) host=darwin-arm64 ;;
    Linux-aarch64|Linux-arm64) host=linux-arm64 ;;
    Linux-x86_64) host=linux-x86_64 ;;
    *) echo 'Use an Apple Silicon Mac or an ARM64/Intel Linux build host.' >&2; exit 1 ;;
esac
name="bazel-$version-$host"
expected=$(awk -v name="$name" '$2 == name {print $1}' "$project_dir/tools/bazel.sha256")
if [[ -z "$expected" ]]; then
    echo "No pinned checksum for $name; update tools/bazel.sha256 with .bazelversion." >&2
    exit 1
fi
default_cache="$HOME/Library/Caches"
[[ "$host" == linux-* ]] && default_cache="$HOME/.cache"
cache="${XDG_CACHE_HOME:-$default_cache}/MTGO-OSX"
binary="$cache/$name"
mkdir -p "$cache"
if [[ ! -x "$binary" ]]; then
    download=$(mktemp "$cache/download.XXXXXX")
    trap 'rm -f "$download"' EXIT
    curl --fail --location --retry 3 --proto '=https' \
        "https://github.com/bazelbuild/bazel/releases/download/$version/$name" -o "$download"
    printf '%s  %s\n' "$expected" "$download" | shasum -a 256 -c -
    chmod 755 "$download"
    mv "$download" "$binary"
    trap - EXIT
fi
cd "$project_dir"
exec "$binary" "$@"
