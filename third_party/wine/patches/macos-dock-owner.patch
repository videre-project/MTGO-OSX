+    - (void) requestWindowAction:(NSString*)action
+    {
+        int type;
+        macdrv_event* event;
+
+        if (disabled || closing) return;
+
+        /* Borderless Win32 windows have no Cocoa titlebar buttons. Request the
+           corresponding system command instead of changing the Cocoa window. */
+        if ([action isEqualToString:@"close"]) type = WINDOW_CLOSE_REQUESTED;
+        else if ([action isEqualToString:@"minimize"]) type = WINDOW_MINIMIZE_REQUESTED;
+        else if ([action isEqualToString:@"zoom"])
+            type = maximized ? WINDOW_RESTORE_REQUESTED : WINDOW_MAXIMIZE_REQUESTED;
+        else return;
+
+        event = macdrv_create_event(type, self);
+        [queue postEvent:event];
+        macdrv_release_event(event);
+    }
