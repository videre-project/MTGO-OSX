+/* Called only from Win32 DestroyWindow, not Cocoa window recreation or minimization. */
+void macdrv_notify_window_destroyed(macdrv_window window)
+{
+@autoreleasepool
+{
+    OnMainThread(^{
+        WineApplicationController* controller = [WineApplicationController sharedController];
+        if (controller.dockOwner && main_window_title && windows_process_name &&
+            [[(NSWindow*)window title] isEqualToString:(NSString*)main_window_title])
+            [[NSDistributedNotificationCenter defaultCenter] postNotificationName:WineAppDockProxyWindowClosed
+                                                                          object:[@(controller.dockOwner.processIdentifier) stringValue]
+                                                                        userInfo:@{@"pid": @(getpid()),
+                                                                                   @"processName": (NSString*)windows_process_name}
+                                                              deliverImmediately:YES];
+    });
+}
