 static PTHEME_FILE tfActiveTheme;
 
 /***********************************************************************/
+
+BOOL MSSTYLES_IsBundledAeroTheme(LPCWSTR path)
+{
+    static const WCHAR suffix[] = L"\\resources\\themes\\aero\\aero.msstyles";
+    WCHAR windows_dir[MAX_PATH];
+    UINT length = GetWindowsDirectoryW(windows_dir, ARRAY_SIZE(windows_dir));
+
+    return length && length < ARRAY_SIZE(windows_dir) &&
+           !wcsnicmp(path, windows_dir, length) && !lstrcmpiW(path + length, suffix);
+}
 
