+#ifdef __APPLE__
+/* Darwin reserves the low 4 GB. Wine code uses the mapped pointer;
+ * unmodified Windows code can still read KUSER_SHARED_DATA at its fixed ABI
+ * address. Emulate ordinary integer loads from that read-only page only. */
+static ULONG64 get_load_register( ucontext_t *context, unsigned int reg, BOOL base )
+{
+    if (reg < 29) return REGn_sig( reg, context );
+    if (reg == 29) return FP_sig( context );
+    if (reg == 30) return LR_sig( context );
+    return base ? SP_sig( context ) : 0;
+}
+
+static void set_load_register( ucontext_t *context, unsigned int reg, ULONG64 value, BOOL base )
+{
+    if (reg < 29) REGn_sig( reg, context ) = value;
+    else if (reg == 29) FP_sig( context ) = value;
+    else if (reg == 30) LR_sig( context ) = value;
+    else if (base) SP_sig( context ) = value;
+}
+
+static BOOL handle_same_page_store( ucontext_t *context, const EXCEPTION_RECORD *rec )
+{
+    ULONG_PTR fault = rec->ExceptionInformation[1], base, address;
+    unsigned int instr, rn, rt, rt2, mode, width, opc;
+    LONG64 offset;
+    BYTE buffer[16];
+    ULONG64 value;
+
+    if (rec->ExceptionInformation[0] != EXCEPTION_WRITE_FAULT ||
+        (fault & ~(get_host_page_size() - 1)) != (PC_sig(context) & ~(get_host_page_size() - 1))) return FALSE;
+    instr = *(const ULONG *)PC_sig(context);
+    /* STP/STNP integer registers, 32 or 64 bits, all immediate modes. */
+    if ((instr & 0x3e400000) != 0x28000000) return FALSE;
+    opc = instr >> 30;
+    if (opc != 0 && opc != 2) return FALSE;
+    width = opc == 2 ? 8 : 4;
+    mode = (instr >> 23) & 3;
+    rn = (instr >> 5) & 31;
+    rt = instr & 31;
+    rt2 = (instr >> 10) & 31;
+    if ((mode & 1) && rn != 31 && (rn == rt || rn == rt2)) return FALSE;
+    offset = ((INT32)(instr << 10) >> 25) * (LONG64)width;
+    base = get_load_register( context, rn, TRUE );
+    address = base + (mode == 1 ? 0 : offset);
+    if (fault < address || fault >= address + 2 * width) return FALSE;
+    value = get_load_register( context, rt, FALSE );
+    memcpy( buffer, &value, width );
+    value = get_load_register( context, rt2, FALSE );
+    memcpy( buffer + width, &value, width );
+    if (!virtual_store_exec_memory( (void *)address, buffer, 2 * width )) return FALSE;
+    if (mode & 1) set_load_register( context, rn, base + offset, TRUE );
+    PC_sig(context) += 4;
+    TRACE( "emulated same-page store %08x to %p\n", instr, (void *)address );
+    return TRUE;
+}
+
+static BOOL handle_shared_data_load( ucontext_t *context, const EXCEPTION_RECORD *rec )
+{
+    ULONG_PTR fault = rec->ExceptionInformation[1], address, base;
+    unsigned int instr, size, opc, rn, rt, mode = 0;
+    LONG64 offset = 0;
+    ULONG64 value = 0;
+    BOOL acquire = FALSE;
+
+    if (rec->ExceptionInformation[0] != EXCEPTION_READ_FAULT ||
+        fault < 0x7ffe0000 || fault >= 0x7ffe1000 || (PC_sig(context) & 3)) return FALSE;
+    instr = *(const ULONG *)PC_sig(context);
+    size = instr >> 30;
+    opc = (instr >> 22) & 3;
+    rn = (instr >> 5) & 31;
+    rt = instr & 31;
+    base = get_load_register( context, rn, TRUE );
+    if ((instr & 0x3f000000) == 0x39000000) /* LDR[B/H/SW], unsigned immediate */
+        offset = ((instr >> 10) & 0xfff) << size;
+    else if ((instr & 0x3f200000) == 0x38000000) /* unscaled/pre/post immediate */
+    {
+        mode = (instr >> 10) & 3;
+        if (mode == 2 || (mode && rn != 31 && rn == rt)) return FALSE;
+        offset = (INT32)(instr << 11) >> 23;
+    }
+    else if ((instr & 0x3ffffc00) == 0x08dffc00) /* LDAR[B/H] */
+    {
+        opc = 1;
+        acquire = TRUE;
+    }
+    else
+    {
+        WARN( "unhandled shared-data load opcode %08x at %p\n", instr, (void *)PC_sig(context) );
+        return FALSE;
+    }
+    if (!opc || (opc == 2 && size == 3) || (opc == 3 && size >= 2)) return FALSE;
+    address = base + (mode == 1 ? 0 : offset);
+    if (address != fault || address < 0x7ffe0000 || address > 0x7ffe1000 - (1u << size)) return FALSE;
+    memcpy( &value, (const char *)user_shared_data + address - 0x7ffe0000, 1u << size );
+    if (acquire) __atomic_thread_fence( __ATOMIC_ACQUIRE );
+    if (opc >= 2) value = (LONG64)(value << (64 - (8u << size))) >> (64 - (8u << size));
+    if (opc == 3) value = (ULONG)value;
+    if (mode) set_load_register( context, rn, base + offset, TRUE );
+    set_load_register( context, rt, value, FALSE );
+    PC_sig(context) += 4;
+    TRACE( "read fixed shared data at %p using %08x\n", (void *)address, instr );
+    return TRUE;
+}
+#endif
