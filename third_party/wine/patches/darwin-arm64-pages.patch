+        NTSTATUS status;
+        char *end = base + size;
+
+        if (base < host_start &&
+            (status = decommit_partial_host_page( base, min( end, host_start ) - base ))) return status;
+        if (host_end >= base && host_end < end &&
+            (status = decommit_partial_host_page( host_end, end - host_end ))) return status;
+    }
+#endif
