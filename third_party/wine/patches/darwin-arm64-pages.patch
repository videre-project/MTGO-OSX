+#if defined(__APPLE__) && defined(__aarch64__)
+/* A partial host page cannot be remapped without discarding adjacent live data.
+ * Clear the decommitted bytes so a later commit still returns zeroed memory. */
+static NTSTATUS decommit_partial_host_page( char *base, size_t size )
+{
+    char *page = ROUND_ADDR( base, host_page_mask );
+
+    if (mprotect( page, host_page_size, PROT_READ | PROT_WRITE )) return STATUS_ACCESS_DENIED;
+    memset( base, 0, size );
+    set_page_vprot_bits( base, size, 0, VPROT_COMMITTED );
+
+    /* Mark adjacent write-watched pages dirty while writes are enabled. */
+    set_page_vprot_bits( page, host_page_size, 0, VPROT_WRITEWATCH );
+    if (mprotect_range( page, host_page_size, 0, 0 )) return STATUS_ACCESS_DENIED;
+    return STATUS_SUCCESS;
+}
+#endif
+
+
 /***********************************************************************
  *           decommit_pages
