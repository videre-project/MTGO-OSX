+/* Native sheets for Wine common item dialogs. */
+#include "config.h"
+#import <AppKit/AppKit.h>
+#import <UniformTypeIdentifiers/UniformTypeIdentifiers.h>
+#include "wine/macfiledialog.h"
+#import "cocoa_event.h"
+
+static NSString *panel_string(const unsigned short *str)
+{
+    NSUInteger length = 0;
+    if (!str) return @"";
+    while (str[length]) length++;
+    return [NSString stringWithCharacters:str length:length];
+}
+
+/* One session per sheet. The Windows thread reads its selection after the
+ * completion handler leaves the group and before releasing the session. */
+@interface WineFilePanel : NSObject
+{
+@public
+    dispatch_group_t finished;
+    NSInteger selected;
+    NSUInteger count;
+    NSMutableData *paths;
+    NSSavePanel *panel;
+    NSMutableArray *types;
+    NSPopUpButton *formats;
+}
+- (BOOL)begin:(const struct mac_file_panel *)request owner:(NSWindow *)owner;
+- (void)changeFormat:(id)sender;
+@end
+
+@implementation WineFilePanel
+- (BOOL)begin:(const struct mac_file_panel *)request owner:(NSWindow *)owner
+{
+    if (![owner isVisible] || [owner attachedSheet]) return NO;
+
+    types = [[NSMutableArray alloc] init];
+    formats = [[NSPopUpButton alloc] initWithFrame:NSZeroRect pullsDown:NO];
+    selected = request->filter_index;
+    for (unsigned int i = 0; i < request->filter_count; i++)
+    {
+        NSString *pattern = panel_string(request->filters[i].pattern);
+        NSMutableArray *extensions = [NSMutableArray array];
+        for (NSString *glob in [pattern componentsSeparatedByString:@";"])
+        {
+            NSString *ext;
+            UTType *type;
+            if ([glob isEqualToString:@"*.*"] || [glob isEqualToString:@"*"])
+            {
+                [extensions setArray:@[UTTypeItem]];
+                break;
+            }
+            if (![glob hasPrefix:@"*."] || glob.length <= 2) return NO;
+            ext = [glob substringFromIndex:2];
+            if ([ext rangeOfCharacterFromSet:[NSCharacterSet characterSetWithCharactersInString:@"*?/\\"]].location != NSNotFound)
+                return NO;
+            type = [UTType typeWithFilenameExtension:ext];
+            if (!type) return NO;
+            [extensions addObject:type];
+            if (request->save && !request->filter_index && [ext caseInsensitiveCompare:panel_string(request->default_ext)] == NSOrderedSame)
+                selected = i;
+        }
+        [types addObject:extensions];
+        [formats addItemWithTitle:panel_string(request->filters[i].name)];
+    }
+
+    if (request->save)
+    {
+        panel = [[NSSavePanel savePanel] retain];
+        panel.nameFieldStringValue = panel_string(request->filename);
+        panel.extensionHidden = NO;
+    }
+    else
+    {
+        NSOpenPanel *open = [NSOpenPanel openPanel];
+        open.allowsMultipleSelection = request->multiple;
+        open.accessoryViewDisclosed = YES;
+        panel = [open retain];
+    }
+    if (request->directory)
+        panel.directoryURL = [NSURL fileURLWithFileSystemRepresentation:request->directory isDirectory:YES relativeToURL:nil];
+    panel.title = panel_string(request->title);
+    if (request->prompt) panel.prompt = panel_string(request->prompt);
+    [formats selectItemAtIndex:selected];
+    if (formats.numberOfItems > 1)
+    {
+        [formats sizeToFit];
+        [formats setTarget:self];
+        [formats setAction:@selector(changeFormat:)];
+        panel.accessoryView = formats;
+    }
+    [self changeFormat:nil];
+
+    finished = dispatch_group_create();
+    dispatch_group_enter(finished);
+    [panel beginSheetModalForWindow:owner completionHandler:^(NSModalResponse result) {
+        if (result == NSModalResponseOK)
+        {
+            NSArray *urls = [panel isKindOfClass:[NSOpenPanel class]] ? [(NSOpenPanel *)panel URLs] : @[panel.URL];
+            paths = [[NSMutableData alloc] init];
+            for (NSURL *url in urls)
+            {
+                const char *name = [url fileSystemRepresentation];
+                [paths appendBytes:name length:strlen(name) + 1];
+            }
+            count = urls.count;
+        }
+        dispatch_group_leave(finished);
+    }];
+    return YES;
+}
+
+- (void)changeFormat:(id)sender
+{
+    selected = formats.indexOfSelectedItem;
+    if (selected >= 0) panel.allowedContentTypes = types[selected];
+}
+
+- (void)dealloc
+{
+    [panel release];
+    [formats release];
+    [types release];
+    [paths release];
+    if (finished) dispatch_release(finished);
+    [super dealloc];
+}
+@end
+
+int macdrv_cocoa_file_panel(struct mac_file_panel *request, void *owner)
+{
+    WineFilePanel *session = request->session;
+    switch (request->action)
+    {
+    case panel_begin:
+        OnMainThread(^{
+            WineFilePanel *new_session = [[WineFilePanel alloc] init];
+            if ([new_session begin:request owner:(NSWindow *)owner]) request->session = new_session;
+            else [new_session release];
+        });
+        return request->session != NULL;
+    case panel_wait:
+        dispatch_group_wait(session->finished, DISPATCH_TIME_FOREVER);
+        request->filter_index = session->selected;
+        request->paths = session->paths.bytes;
+        request->path_count = session->count;
+        break;
+    case panel_cancel:
+        OnMainThread(^{ [session->panel cancel:nil]; });
+        break;
+    case panel_release:
+        OnMainThread(^{ [session release]; });
+        break;
+    }
+    return 1;
+}
