+/* Private interface between comdlg32 and the 64-bit Mac display driver. */
+#ifndef __WINE_MACFILEDIALOG_H
+#define __WINE_MACFILEDIALOG_H
+
+enum mac_file_panel_action { panel_begin, panel_wait, panel_cancel, panel_release };
+
+struct mac_file_filter
+{
+    const unsigned short *name, *pattern;
+};
+
+struct mac_file_panel
+{
+    enum mac_file_panel_action action;
+    void *owner;
+    const unsigned short *title, *prompt, *filename, *default_ext;
+    const char *directory;
+    const struct mac_file_filter *filters;
+    unsigned int filter_count, filter_index;
+    int save, multiple;
+
+    void *session;
+    /* NUL-terminated filesystem paths, valid until panel_release. */
+    const char *paths;
+    unsigned int path_count;
+};
+#endif
