+/* MTGO uses WPF's filesystem dialogs for both deck import and export. */
+typedef HRESULT (WINAPI *mac_file_panel_fn)(struct mac_file_panel *);
+
+struct native_file_dialog
+{
+    struct mac_file_panel panel;
+    mac_file_panel_fn show;
+};
+
+static DWORD WINAPI wait_for_file_panel(void *arg)
+{
+    struct native_file_dialog *dialog = arg;
+    return dialog->show(&dialog->panel);
+}
+
+static HRESULT read_file_panel_results(FileDialogImpl *This, const struct mac_file_panel *panel)
+{
+    IShellItemArray *results = NULL;
+    const char *path = panel->paths;
+    LPITEMIDLIST *ids;
+    HRESULT hr = E_OUTOFMEMORY;
+    UINT i;
+
+    if (!panel->path_count) return HRESULT_FROM_WIN32(ERROR_CANCELLED);
+    if (!(ids = calloc(panel->path_count, sizeof(*ids)))) return hr;
+    for (i = 0; i < panel->path_count; ++i)
+    {
+        WCHAR *dos_path = wine_get_dos_file_name(path);
+        if (!dos_path)
+        {
+            hr = HRESULT_FROM_WIN32(ERROR_PATH_NOT_FOUND);
+            goto done;
+        }
+        ids[i] = SHSimpleIDListFromPath(dos_path);
+        HeapFree(GetProcessHeap(), 0, dos_path);
+        if (!ids[i]) goto done;
+        path += strlen(path) + 1;
+    }
+
+    hr = SHCreateShellItemArrayFromIDLists(panel->path_count, (PCIDLIST_ABSOLUTE *)ids, &results);
+    if (SUCCEEDED(hr))
+    {
+        if (This->psia_results) IShellItemArray_Release(This->psia_results);
+        This->psia_results = results;
+        This->filetypeindex = panel->filter_index;
+        hr = events_OnFileOk(This);
+    }
+done:
+    for (i = 0; i < panel->path_count; ++i) ILFree(ids[i]);
+    free(ids);
+    return hr;
+}
