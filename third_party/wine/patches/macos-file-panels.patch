+static HRESULT show_mac_file_panel(FileDialogImpl *This, HWND owner)
+{
+    struct native_file_dialog dialog = {0};
+    struct mac_file_panel *panel = &dialog.panel, control = {0};
+    const FILEOPENDIALOGOPTIONS supported = FOS_FORCEFILESYSTEM | FOS_ALLOWMULTISELECT | FOS_PATHMUSTEXIST |
+        FOS_FILEMUSTEXIST | FOS_OVERWRITEPROMPT | FOS_NOCHANGEDIR | FOS_DEFAULTNOMINIMODE | FOS_STRICTFILETYPES;
+    HMODULE driver = GetModuleHandleW(L"winemac.drv");
+    IShellItem *folder = This->psi_setfolder ? This->psi_setfolder : This->psi_defaultfolder;
+    HWND focus;
+    HANDLE handles[2];
+    BOOL enable_owner = FALSE, canceled = FALSE, quit = FALSE;
+    DWORD wait, quit_code = 0;
+    WCHAR *name;
+    MSG msg;
+    HRESULT hr;
+
+    if (!owner || !driver || !This->filterspec_count || (This->options & ~supported) ||
+        !list_empty(&This->cctrls) || This->custom_cancelbutton ||
+        This->custom_filenamelabel)
+        return E_NOTIMPL;
+    if (This->native_owner) return E_UNEXPECTED;
+    dialog.show = (mac_file_panel_fn)GetProcAddress(driver, "wine_mac_file_panel");
+    if (!dialog.show) return E_NOTIMPL;
+
+    panel->owner = owner;
+    panel->save = This->dlg_type == ITEMDLG_TYPE_SAVE;
+    panel->multiple = !!(This->options & FOS_ALLOWMULTISELECT);
+    panel->title = This->custom_title;
+    panel->prompt = This->custom_okbutton;
+    panel->filename = This->set_filename;
+    panel->default_ext = This->default_ext;
+    panel->filters = (const struct mac_file_filter *)This->filterspecs;
+    panel->filter_count = This->filterspec_count;
+    panel->filter_index = This->filetypeindex;
+    if (folder && SUCCEEDED(IShellItem_GetDisplayName(folder, SIGDN_FILESYSPATH, &name)))
+    {
+        panel->directory = wine_get_unix_file_name(name);
+        CoTaskMemFree(name);
+    }
+    focus = GetFocus();
+    hr = dialog.show(panel);
+    HeapFree(GetProcessHeap(), 0, (char *)panel->directory);
+    if (FAILED(hr)) return hr;
+
+    This->native_owner = owner;
+    control.session = panel->session;
+    handles[1] = This->native_cancel = CreateEventW(NULL, TRUE, FALSE, NULL);
+    panel->action = panel_wait;
+    handles[0] = handles[1] ? CreateThread(NULL, 0, wait_for_file_panel, &dialog, 0, NULL) : NULL;
+    if (!handles[0]) hr = HRESULT_FROM_WIN32(GetLastError());
+    else
+    {
+        enable_owner = IsWindowEnabled(owner);
+        if (enable_owner) EnableWindow(owner, FALSE);
+        for (;;)
+        {
+            wait = MsgWaitForMultipleObjectsEx(canceled ? 1 : 2, handles, INFINITE, QS_ALLINPUT, MWMO_INPUTAVAILABLE);
+            if (wait == WAIT_OBJECT_0) break;
+            if (!canceled && wait == WAIT_OBJECT_0 + 1)
+            {
+                hr = This->native_close_result;
+                canceled = TRUE;
+                control.action = panel_cancel;
+                dialog.show(&control);
+                continue;
+            }
+            if (wait == WAIT_FAILED)
+            {
+                hr = HRESULT_FROM_WIN32(GetLastError());
+                break;
+            }
+            if (!PeekMessageW(&msg, NULL, 0, 0, PM_REMOVE)) continue;
+            if (msg.message == WM_QUIT)
+            {
+                quit = TRUE;
+                quit_code = msg.wParam;
+                IFileDialog2_Close(&This->IFileDialog2_iface, HRESULT_FROM_WIN32(ERROR_CANCELLED));
+                continue;
+            }
+            TranslateMessage(&msg);
+            DispatchMessageW(&msg);
+            if (!canceled && !IsWindow(owner))
+                IFileDialog2_Close(&This->IFileDialog2_iface, HRESULT_FROM_WIN32(ERROR_CANCELLED));
+        }
+    }
+
+    if (FAILED(hr) && !canceled)
+    {
+        control.action = panel_cancel;
+        dialog.show(&control);
+    }
+    if (handles[0])
+    {
+        WaitForSingleObject(handles[0], INFINITE);
+        CloseHandle(handles[0]);
+    }
+    if (enable_owner && IsWindow(owner))
+    {
+        EnableWindow(owner, TRUE);
+        SetActiveWindow(owner);
+        if (focus == owner || IsChild(owner, focus)) SetFocus(focus);
+    }
+    if (SUCCEEDED(hr) && !canceled)
+    {
+        /* WPF reads the filenames and the format index during OnFileOk. */
+        hr = read_file_panel_results(This, panel);
+        if (WaitForSingleObject(handles[1], 0) == WAIT_OBJECT_0) hr = This->native_close_result;
+    }
+    if (handles[1]) CloseHandle(handles[1]);
+    This->native_cancel = NULL;
+    This->native_owner = NULL;
+    control.action = panel_release;
+    dialog.show(&control);
+    if (quit) PostQuitMessage(quit_code);
+    return hr;
+}
