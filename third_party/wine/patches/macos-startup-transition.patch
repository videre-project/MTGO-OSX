+    - (void) deferStartupPresentation
+    {
+        if (startupPresentationPending) return;
+        startupPresentationPending = YES;
+        startupAlpha = [self alphaValue];
+        startupIgnoredMouseEvents = [self ignoresMouseEvents];
+        [self setIgnoresMouseEvents:YES];
+        [super setAlphaValue:0];
+    }
+
+    - (void) setAlphaValue:(CGFloat)alpha
+    {
+        if (startupPresentationPending) startupAlpha = alpha;
+        else [super setAlphaValue:alpha];
+    }
+
+    - (void) revealStartupPresentationWithDuration:(NSTimeInterval)duration
+    {
+        if (!startupPresentationPending || closing) return;
+        startupPresentationPending = NO;
+        [self setIgnoresMouseEvents:startupIgnoredMouseEvents];
+        if (duration <= 0 || [[NSWorkspace sharedWorkspace] accessibilityDisplayShouldReduceMotion])
+        {
+            [super setAlphaValue:startupAlpha];
+            return;
+        }
+        [NSAnimationContext runAnimationGroup:^(NSAnimationContext* context) {
+            context.duration = duration;
+            context.timingFunction = [CAMediaTimingFunction functionWithName:kCAMediaTimingFunctionEaseInEaseOut];
+            [[self animator] setAlphaValue:startupAlpha];
+        } completionHandler:nil];
+    }
