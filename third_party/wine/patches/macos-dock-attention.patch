 /***********************************************************************
+ *              FlashWindowEx   (MACDRV.@)
+ */
+void macdrv_FlashWindowEx(FLASHWINFO *info)
+{
+    /* Caption-only flashing must not change the application attention indicator. */
+    if (!info->dwFlags || (info->dwFlags & FLASHW_TRAY))
+        macdrv_request_attention(info->dwFlags);
+}
